include_guard(GLOBAL)
include(CMakeParseArguments)

set(RDF_EXTENSION_API_VERSION 1)
option(RDF_BUILD_EXTENSIONS "Discover and build optional source extensions" ON)
set(RDF_EXTENSION_PATHS "" CACHE STRING "Additional extension checkouts (semicolon-separated); override discovered checkouts of the same name")
set(RDF_REQUIRED_EXTENSIONS "" CACHE STRING "Extension names that must be enabled")

# An extension's configure hook owns its options and calls this function once.
function(rdf_register_extension)
    cmake_parse_arguments(EXT "" "NAME;ENABLED;TARGET;PYTHON_PLUGIN_HEADER;PYTHON_PLUGIN_FACTORY;PYTHON_ANALYZER_CONFIGURATOR;PYTHON_CAPABILITY;TEST_DIRECTORY;XRD_OPEN_POLICY_HEADER" "TEST_ENVIRONMENT" ${ARGN})
    if(EXT_UNPARSED_ARGUMENTS OR EXT_KEYWORDS_MISSING_VALUES OR NOT DEFINED EXT_ENABLED OR NOT EXT_NAME STREQUAL RDF_EXTENSION_NAME)
        message(FATAL_ERROR "Invalid registration for extension ${RDF_EXTENSION_NAME}")
    endif()
    get_property(_registered GLOBAL PROPERTY RDF_REGISTERED_EXTENSIONS)
    if(EXT_NAME IN_LIST _registered)
        message(FATAL_ERROR "Extension ${EXT_NAME} registered twice")
    endif()
    if(EXT_ENABLED AND NOT EXT_TARGET)
        message(FATAL_ERROR "Enabled extension ${EXT_NAME} must register a target")
    endif()
    if(EXT_ENABLED AND EXT_XRD_OPEN_POLICY_HEADER)
        if(RDF_XRD_OPEN_POLICY_HEADER AND NOT RDF_XRD_OPEN_POLICY_HEADER STREQUAL EXT_XRD_OPEN_POLICY_HEADER)
            message(FATAL_ERROR "Multiple enabled extensions provide the exclusive XRootD open policy")
        endif()
        set(RDF_XRD_OPEN_POLICY_HEADER "${EXT_XRD_OPEN_POLICY_HEADER}" PARENT_SCOPE)
    endif()
    if((EXT_PYTHON_PLUGIN_HEADER AND NOT EXT_PYTHON_PLUGIN_FACTORY) OR
       (EXT_PYTHON_PLUGIN_FACTORY AND NOT EXT_PYTHON_PLUGIN_HEADER))
        message(FATAL_ERROR "Extension ${EXT_NAME} must supply both Python plugin header and factory")
    endif()
    if(EXT_PYTHON_ANALYZER_CONFIGURATOR AND NOT EXT_PYTHON_PLUGIN_HEADER)
        message(FATAL_ERROR "Extension ${EXT_NAME} Python analyzer configurator requires its plugin header")
    endif()
    set_property(GLOBAL APPEND PROPERTY RDF_REGISTERED_EXTENSIONS "${EXT_NAME}")
    foreach(_field ENABLED TARGET PYTHON_PLUGIN_HEADER PYTHON_PLUGIN_FACTORY PYTHON_ANALYZER_CONFIGURATOR PYTHON_CAPABILITY TEST_DIRECTORY TEST_ENVIRONMENT)
        set_property(GLOBAL PROPERTY "RDF_EXTENSION_${EXT_NAME}_${_field}" "${EXT_${_field}}")
    endforeach()
    set_property(GLOBAL PROPERTY "RDF_EXTENSION_${EXT_NAME}_SOURCE" "${RDF_EXTENSION_SOURCE_DIR}")
    if(EXT_ENABLED)
        set_property(GLOBAL APPEND PROPERTY RDF_ENABLED_EXTENSIONS "${EXT_NAME}")
    endif()
    message(STATUS "Extension ${EXT_NAME}: ${EXT_ENABLED} (${RDF_EXTENSION_SOURCE_DIR})")
endfunction()

# Configure hooks run before dependency discovery so they can supply optional
# toolchain hints. This macro deliberately preserves hook variables in scope.
macro(rdf_discover_extensions)
    set_property(GLOBAL PROPERTY RDF_REGISTERED_EXTENSIONS "")
    set_property(GLOBAL PROPERTY RDF_ENABLED_EXTENSIONS "")
    set(RDF_XRD_OPEN_POLICY_HEADER "")
    if(RDF_BUILD_EXTENSIONS)
        file(GLOB _rdf_discovered CONFIGURE_DEPENDS LIST_DIRECTORIES TRUE "${PROJECT_SOURCE_DIR}/extensions/*/rdf-extension.json")
        set(_rdf_candidates ${RDF_EXTENSION_PATHS})
        set(_rdf_explicit_names "")
        foreach(_rdf_manifest IN LISTS _rdf_discovered)
            get_filename_component(_rdf_source "${_rdf_manifest}" DIRECTORY)
            list(APPEND _rdf_candidates "${_rdf_source}")
        endforeach()
        foreach(_rdf_candidate IN LISTS _rdf_candidates)
            get_filename_component(RDF_EXTENSION_SOURCE_DIR "${_rdf_candidate}" REALPATH BASE_DIR "${PROJECT_SOURCE_DIR}")
            if(NOT EXISTS "${RDF_EXTENSION_SOURCE_DIR}/rdf-extension.json")
                message(FATAL_ERROR "Extension checkout has no rdf-extension.json: ${RDF_EXTENSION_SOURCE_DIR}")
            endif()
            file(READ "${RDF_EXTENSION_SOURCE_DIR}/rdf-extension.json" _rdf_manifest_json)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                "${RDF_EXTENSION_SOURCE_DIR}/rdf-extension.json")
            string(JSON RDF_EXTENSION_NAME GET "${_rdf_manifest_json}" name)
            string(JSON _rdf_api GET "${_rdf_manifest_json}" core_api_version)
            string(JSON _rdf_hook GET "${_rdf_manifest_json}" configure)
            if(NOT RDF_EXTENSION_NAME MATCHES "^[a-z][a-z0-9_]*$")
                message(FATAL_ERROR "Invalid extension name: ${RDF_EXTENSION_NAME}")
            endif()
            get_property(_rdf_registered GLOBAL PROPERTY RDF_REGISTERED_EXTENSIONS)
            if(RDF_EXTENSION_NAME IN_LIST _rdf_registered)
                get_property(_rdf_existing GLOBAL PROPERTY "RDF_EXTENSION_${RDF_EXTENSION_NAME}_SOURCE")
                if(_rdf_existing STREQUAL RDF_EXTENSION_SOURCE_DIR)
                    continue()
                endif()
                if(_rdf_candidate IN_LIST RDF_EXTENSION_PATHS OR NOT RDF_EXTENSION_NAME IN_LIST _rdf_explicit_names)
                    message(FATAL_ERROR "Duplicate extension ${RDF_EXTENSION_NAME}: ${_rdf_existing} and ${RDF_EXTENSION_SOURCE_DIR}")
                endif()
                message(STATUS "Using explicit checkout for extension ${RDF_EXTENSION_NAME}: ${_rdf_existing}")
                continue()
            endif()
            if(NOT _rdf_api STREQUAL "${RDF_EXTENSION_API_VERSION}")
                message(FATAL_ERROR "Extension ${RDF_EXTENSION_NAME} requires extension API ${_rdf_api}; framework provides ${RDF_EXTENSION_API_VERSION}")
            endif()
            include("${RDF_EXTENSION_SOURCE_DIR}/${_rdf_hook}")
            get_property(_rdf_registered GLOBAL PROPERTY RDF_REGISTERED_EXTENSIONS)
            if(NOT RDF_EXTENSION_NAME IN_LIST _rdf_registered)
                message(FATAL_ERROR "Configure hook did not register extension ${RDF_EXTENSION_NAME}")
            endif()
            if(_rdf_candidate IN_LIST RDF_EXTENSION_PATHS)
                list(APPEND _rdf_explicit_names "${RDF_EXTENSION_NAME}")
            endif()
        endforeach()
    endif()
    get_property(RDF_ENABLED_EXTENSIONS GLOBAL PROPERTY RDF_ENABLED_EXTENSIONS)
    foreach(_rdf_required IN LISTS RDF_REQUIRED_EXTENSIONS)
        if(NOT _rdf_required IN_LIST RDF_ENABLED_EXTENSIONS)
            message(FATAL_ERROR "Required extension ${_rdf_required} is missing or disabled. Download its checkout, add RDF_EXTENSION_PATHS, and enable its extension-owned option.")
        endif()
    endforeach()
endmacro()

function(rdf_add_extensions)
    get_property(_extensions GLOBAL PROPERTY RDF_ENABLED_EXTENSIONS)
    foreach(_name IN LISTS _extensions)
        get_property(_source GLOBAL PROPERTY "RDF_EXTENSION_${_name}_SOURCE")
        get_property(_target GLOBAL PROPERTY "RDF_EXTENSION_${_name}_TARGET")
        set(RDF_EXTENSION_NAME "${_name}")
        set(RDF_EXTENSION_SOURCE_DIR "${_source}")
        add_subdirectory("${_source}" "${CMAKE_BINARY_DIR}/extensions/${_name}")
        if(NOT TARGET "${_target}")
            message(FATAL_ERROR "Extension ${_name} did not create registered target ${_target}")
        endif()
        set_property(GLOBAL APPEND PROPERTY RDF_EXTENSION_TARGETS "${_target}")
    endforeach()
endfunction()

function(rdf_add_extension_tests)
    get_property(_extensions GLOBAL PROPERTY RDF_ENABLED_EXTENSIONS)
    foreach(_name IN LISTS _extensions)
        get_property(_source GLOBAL PROPERTY "RDF_EXTENSION_${_name}_SOURCE")
        get_property(_tests GLOBAL PROPERTY "RDF_EXTENSION_${_name}_TEST_DIRECTORY")
        if(_tests)
            set(RDF_EXTENSION_NAME "${_name}")
            set(RDF_EXTENSION_SOURCE_DIR "${_source}")
            add_subdirectory("${_source}/${_tests}" "${CMAKE_BINARY_DIR}/extensions/${_name}/tests")
        endif()
    endforeach()
endfunction()

# The same registry generates generic C++ metadata/factories and Python test
# environment settings. No extension-specific feature switches belong here.
function(rdf_generate_extension_config)
    get_property(_extensions GLOBAL PROPERTY RDF_REGISTERED_EXTENSIONS)
    list(LENGTH _extensions _count)
    set(_metadata "#pragma once\n#include <array>\nnamespace rdf {\nstruct ExtensionBuildInfo { const char *name; bool enabled; const char *revision; bool dirty; const char *capability; };\ninline constexpr std::array<ExtensionBuildInfo, ${_count}> extensionBuildInfo{{\n")
    set(_bindings "#pragma once\n#include <string>\n#include <unordered_map>\n#include <stdexcept>\nclass Analyzer;\n")
    set(_factories "")
    set(_configurators "")
    string(REPLACE ";" ":" _python_paths "${RDF_EXTENSION_PATHS}")
    set(_environment "RDF_BUILD_EXTENSIONS=${RDF_BUILD_EXTENSIONS};RDF_EXTENSION_PATHS=${_python_paths}")
    foreach(_name IN LISTS _extensions)
        foreach(_field SOURCE ENABLED PYTHON_PLUGIN_HEADER PYTHON_PLUGIN_FACTORY PYTHON_ANALYZER_CONFIGURATOR PYTHON_CAPABILITY TEST_ENVIRONMENT)
            get_property(_${_field} GLOBAL PROPERTY "RDF_EXTENSION_${_name}_${_field}")
        endforeach()
        set(_enabled false)
        set(_dirty false)
        set(_hash "unavailable")
        if(_ENABLED)
            set(_enabled true)
            execute_process(COMMAND git -C "${_SOURCE}" rev-parse --show-toplevel
                OUTPUT_VARIABLE _git_root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            set(_hash "unknown")
            if(_git_root STREQUAL _SOURCE)
                execute_process(COMMAND git -C "${_SOURCE}" rev-parse HEAD OUTPUT_VARIABLE _hash
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _git_result)
                if(NOT _git_result EQUAL 0)
                    set(_hash "unknown")
                endif()
                execute_process(COMMAND git -C "${_SOURCE}" status --porcelain OUTPUT_VARIABLE _status ERROR_QUIET)
                if(_status)
                    set(_dirty true)
                endif()
            endif()
            if(_PYTHON_PLUGIN_HEADER)
                string(APPEND _bindings "#include <${_PYTHON_PLUGIN_HEADER}>\n")
                string(APPEND _factories "  if (${_PYTHON_PLUGIN_FACTORY}(analyzer, role, type)) return true;\n")
                if(_PYTHON_ANALYZER_CONFIGURATOR)
                    string(APPEND _configurators "  if (extension == \"${_name}\") return ${_PYTHON_ANALYZER_CONFIGURATOR}(analyzer, settings);\n")
                endif()
            endif()
        endif()
        string(APPEND _metadata "  {\"${_name}\", ${_enabled}, \"${_hash}\", ${_dirty}, \"${_PYTHON_CAPABILITY}\"},\n")
        list(APPEND _environment ${_TEST_ENVIRONMENT})
    endforeach()
    string(APPEND _metadata "}};\n}\n")
    string(APPEND _bindings "namespace rdf {\ninline bool addExtensionPythonPlugin(Analyzer &analyzer, const std::string &role, const std::string &type) {\n${_factories}  return false;\n}\n}\n")
    string(APPEND _bindings "namespace rdf {\ninline std::unordered_map<std::string, std::string> configureExtensionPythonAnalyzer(Analyzer &analyzer, const std::string &extension, const std::unordered_map<std::string, std::string> &settings) {\n${_configurators}  throw std::invalid_argument(\"Python analyzer configuration unavailable for extension '\" + extension + \"'; rebuild with the extension enabled and its Python configurator\");\n}\n}\n")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/include")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ExtensionConfig.h.in" "${CMAKE_BINARY_DIR}/include/ExtensionConfig.h" @ONLY)
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ExtensionPythonPlugins.h.in" "${CMAKE_BINARY_DIR}/include/ExtensionPythonPlugins.h" @ONLY)
    set(RDF_EXTENSION_TEST_ENVIRONMENT "${_environment}" PARENT_SCOPE)
endfunction()
