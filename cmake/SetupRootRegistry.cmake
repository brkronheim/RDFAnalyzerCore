# Native executable compatibility patch for the audited ROOT ABIs.
# No installed ROOT file or process-wide preload is changed.
set(RDF_ROOT_REGISTRY_OPTIMIZATION "AUTO" CACHE STRING
    "Compact ROOT Define registries in native executables: AUTO, ON, OFF")
set_property(CACHE RDF_ROOT_REGISTRY_OPTIMIZATION PROPERTY STRINGS AUTO ON OFF)
string(TOUPPER "${RDF_ROOT_REGISTRY_OPTIMIZATION}" _rdf_registry_mode)
if(NOT _rdf_registry_mode MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR "RDF_ROOT_REGISTRY_OPTIMIZATION must be AUTO, ON or OFF")
endif()
set(RDF_ROOT_READER_OPTIMIZATION "AUTO" CACHE STRING
    "Skip redundant RDF Define updates in native executables: AUTO, ON, OFF")
set_property(CACHE RDF_ROOT_READER_OPTIMIZATION PROPERTY STRINGS AUTO ON OFF)
string(TOUPPER "${RDF_ROOT_READER_OPTIMIZATION}" _rdf_reader_mode)
if(NOT _rdf_reader_mode MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR "RDF_ROOT_READER_OPTIMIZATION must be AUTO, ON or OFF")
endif()
set(RDF_ROOT_REGISTRY_AVAILABLE FALSE)
set(RDF_ROOT_READER_AVAILABLE FALSE)
set(RDF_ROOT_LOCALITY_AVAILABLE FALSE)
set(_rdf_abi_available FALSE)
set(_rdf_registry_reason "disabled by configuration")
if(NOT _rdf_registry_mode STREQUAL "OFF" OR NOT _rdf_reader_mode STREQUAL "OFF")
    set(_rdf_registry_reason "requires an audited ROOT release on 64-bit Linux with GNU/Clang")
    set(_rdf_abis "${CMAKE_CURRENT_LIST_DIR}/../core/root_compat/native_abis.tsv")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_rdf_abis}")
    file(STRINGS "${_rdf_abis}" _rdf_abi_rows)
    set(_rdf_registry_hashes)
    foreach(_row IN LISTS _rdf_abi_rows)
        string(REPLACE "	" ";" _fields "${_row}")
        list(POP_FRONT _fields _release _registry_supported)
        if(_release STREQUAL ROOT_VERSION)
            set(_rdf_registry_hashes ${_fields})
            break()
        endif()
    endforeach()
    if(_rdf_registry_hashes AND CMAKE_SYSTEM_NAME STREQUAL "Linux"
       AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
        get_target_property(_rdf_root_includes ROOT::Core INTERFACE_INCLUDE_DIRECTORIES)
        unset(_rdf_registry_include CACHE)
        unset(_rdf_registry_include)
        find_path(_rdf_registry_include ROOT/RDF/RColumnRegister.hxx HINTS ${_rdf_root_includes} NO_DEFAULT_PATH)
        set(_rdf_registry_headers RColumnRegister.hxx RDefineBase.hxx RDefineReader.hxx RLoopManager.hxx RDefine.hxx)
        set(_rdf_abi_available TRUE)
        foreach(_i RANGE 0 4)
            list(GET _rdf_registry_headers ${_i} _header)
            list(GET _rdf_registry_hashes ${_i} _expected)
            set(_file "${_rdf_registry_include}/ROOT/RDF/${_header}")
            if(NOT EXISTS "${_file}")
                set(_rdf_abi_available FALSE)
                set(_rdf_registry_reason "missing ROOT header ${_header}")
                break()
            endif()
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
            file(SHA256 "${_file}" _actual)
            if(NOT _actual STREQUAL _expected)
                set(_rdf_abi_available FALSE)
                set(_rdf_registry_reason "ROOT header ${_header} differs from the audited ${ROOT_VERSION} source")
                break()
            endif()
        endforeach()
        if(_rdf_abi_available AND ROOT_VERSION STREQUAL "6.41.99")
            # This numeric version is also used by development builds.
            set(_rdf_git_info "${_rdf_registry_include}/../etc/gitinfo.txt")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_rdf_git_info}")
            set(_rdf_git_tag "")
            if(EXISTS "${_rdf_git_info}")
                file(STRINGS "${_rdf_git_info}" _rdf_git_tag LIMIT_COUNT 1)
            endif()
            if(NOT _rdf_git_tag STREQUAL "tags/v6-42-00-rc1")
                set(_rdf_abi_available FALSE)
                set(_rdf_registry_reason "ROOT 6.41.99 must be the audited v6-42-00-rc1 build")
            endif()
        endif()
        if(_rdf_abi_available)
            get_target_property(_rdf_registry_library_type ROOT::ROOTDataFrame TYPE)
            if(NOT _rdf_registry_library_type STREQUAL "SHARED_LIBRARY")
                set(_rdf_abi_available FALSE)
                set(_rdf_registry_reason "requires shared ROOTDataFrame for native ELF symbol interposition")
            endif()
        endif()
        if(_rdf_abi_available)
            include(CheckCXXSourceCompiles)
            string(SHA256 _rdf_registry_flags_key "${CMAKE_CXX_COMPILER};${CMAKE_BUILD_TYPE};${CMAKE_TRY_COMPILE_CONFIGURATION};${CMAKE_CXX_FLAGS};${CMAKE_CXX_FLAGS_DEBUG};${CMAKE_CXX_FLAGS_RELEASE};${CMAKE_CXX_FLAGS_RELWITHDEBINFO};${CMAKE_CXX_FLAGS_MINSIZEREL}")
            string(SUBSTRING "${_rdf_registry_flags_key}" 0 12 _rdf_registry_flags_key)
            set(_rdf_registry_abi_test "_rdf_registry_abi_${_rdf_registry_flags_key}")
            check_cxx_source_compiles("#include <string>
#if defined(_GLIBCXX_DEBUG) || !defined(__GLIBCXX__) || !_GLIBCXX_USE_CXX11_ABI
#error incompatible standard library ABI
#endif
int main() { return 0; }" ${_rdf_registry_abi_test})
            if(NOT ${_rdf_registry_abi_test})
                set(_rdf_abi_available FALSE)
                set(_rdf_registry_reason "requires the ordinary libstdc++ C++11 ABI without debug iterators")
            endif()
        endif()
        if(_rdf_abi_available)
            include(CheckLinkerFlag)
            check_linker_flag(CXX "LINKER:--export-dynamic-symbol=rdf_root_registry_optimization_status_v1"
                _rdf_registry_linker_supported)
            if(NOT _rdf_registry_linker_supported)
                set(_rdf_abi_available FALSE)
                set(_rdf_registry_reason "linker does not support selective ELF symbol exports")
            endif()
        endif()
    endif()
endif()
if(NOT _rdf_abi_available)
    if(_rdf_registry_mode STREQUAL "ON" OR _rdf_reader_mode STREQUAL "ON")
        message(FATAL_ERROR "Cannot enable requested ROOT compatibility optimization: ${_rdf_registry_reason}")
    endif()
    message(STATUS "ROOT registry and reader optimizations: OFF (${_rdf_registry_reason})")
    return()
endif()
if(NOT _registry_supported)
    if(_rdf_registry_mode STREQUAL "ON")
        message(FATAL_ERROR "Registry pruning has not been ported to ROOT ${ROOT_VERSION}")
    endif()
    set(_rdf_registry_mode OFF)
    if(_rdf_reader_mode STREQUAL "OFF")
        return()
    endif()
endif()
# Keep the private headers isolated when switching either option in the same build.
set(_rdf_registry_private "${CMAKE_BINARY_DIR}/root_registry_include/${_rdf_registry_mode}-${_rdf_reader_mode}")
file(MAKE_DIRECTORY "${_rdf_registry_private}/ROOT/RDF")
set(_rdf_sources)
set(_rdf_symbols)
if(NOT _rdf_registry_mode STREQUAL "OFF")
    set(RDF_ROOT_REGISTRY_AVAILABLE TRUE)
    file(READ "${_rdf_registry_include}/ROOT/RDF/RColumnRegister.hxx" _header)
    string(REPLACE "   void AddDefine(std::shared_ptr<RDFDetail::RDefineBase> column);"
        "   void AddDefine(std::shared_ptr<RDFDetail::RDefineBase> column);\n   void KeepDirectInputs(const std::vector<std::string> &columns);"
        _header "${_header}")
    file(CONFIGURE OUTPUT "${_rdf_registry_private}/ROOT/RDF/RColumnRegister.hxx" CONTENT "@_header@" @ONLY)
    list(APPEND _rdf_sources "${CMAKE_CURRENT_LIST_DIR}/../core/root_compat/Root640Registry.cc")
    list(APPEND _rdf_symbols _ZN4ROOT6Detail3RDF11RDefineBaseC*
        _ZN4ROOT8Internal3RDF15RColumnRegister9AddDefine* rdf_root_registry_optimization_status_v1)
endif()
if(NOT _rdf_reader_mode STREQUAL "OFF")
    set(RDF_ROOT_READER_AVAILABLE TRUE)
    file(READ "${_rdf_registry_include}/ROOT/RDF/RDefineBase.hxx" _base)
    string(REPLACE "   RDefineBase &operator=(const"
        "   bool HasCurrentEntry(unsigned int slot, Long64_t entry) const { return entry >= 0 && entry == fLastCheckedEntry[slot * RDFInternal::CacheLineStep<Long64_t>()]; }
   RDefineBase &operator=(const"
        _base "${_base}")
    file(READ "${_rdf_registry_include}/ROOT/RDF/RDefineReader.hxx" _reader)
    string(REGEX REPLACE [[void \*GetImpl\(Long64_t entry\) final[^}]*}]] "void *GetImpl(Long64_t entry) final;"
        _reader "${_reader}")
    list(APPEND _rdf_sources "${CMAKE_CURRENT_LIST_DIR}/../core/root_compat/RootDefineReader.cc")
    list(APPEND _rdf_symbols _ZN4ROOT8Internal3RDF13RDefineReader7GetImplEx)
endif()
# The packed reader caches a bound virtual member using the GNU C++ ABI.
# Audit RInterface separately because the inline-Define path modifies it.
option(RDF_ROOT_READER_LOCALITY "Build the audited packed and inline input reader optimizations" ON)
set(_rdf_locality_hash "")
if(ROOT_VERSION STREQUAL "6.40.04")
    set(_rdf_locality_hash "215d849447bb825f818c8d1b60082b69792338587d46dfd3739100e91c841449")
elseif(ROOT_VERSION STREQUAL "6.41.99")
    set(_rdf_locality_hash "f1301299728aec1ce900dd6c5ae05225eb3ee0b805ad76dde3fa77a57a12818a")
endif()
if(RDF_ROOT_READER_LOCALITY AND RDF_ROOT_REGISTRY_AVAILABLE AND RDF_ROOT_READER_AVAILABLE
   AND _rdf_locality_hash AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
   AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    set(_interface "${_rdf_registry_include}/ROOT/RDF/RInterface.hxx")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_interface}")
    file(SHA256 "${_interface}" _interface_hash)
    if(_interface_hash STREQUAL _rdf_locality_hash)
        set(RDF_ROOT_LOCALITY_AVAILABLE TRUE)
        string(REPLACE "   bool HasCurrentEntry("
            "   const Long64_t *LocalityStamp(unsigned slot) const { return &fLastCheckedEntry.at(slot * RDFInternal::CacheLineStep<Long64_t>()); }\n   bool HasCurrentEntry(" _base "${_base}")
        string(REPLACE "   RDefineReader(unsigned"
            "   RDFDetail::RDefineBase &LocalityProducer() const { return fDefine; }\n   void *LocalityValue() const { return fValuePtr; }\n   RDefineReader(unsigned" _reader "${_reader}")
        string(REPLACE "   RDefinesWithReaders(std::shared_ptr"
            "   RDFDetail::RColumnReaderBase &GetLocalityReader(unsigned slot, const std::string &variation);\n   RDefinesWithReaders(std::shared_ptr" _reader "${_reader}")
        list(APPEND _rdf_sources "${CMAKE_CURRENT_LIST_DIR}/../core/root_compat/Root640PackedReader.cc")
        list(APPEND _rdf_symbols _ZN4ROOT8Internal3RDF15RColumnRegister*GetReader* rdf_root_packed_reader_bindings_v1)
        set(RDF_ROOT_INLINE_INCLUDE "${_rdf_registry_private}/inline")
        set(_inline_rdf "${RDF_ROOT_INLINE_INCLUDE}/ROOT/RDF")
        file(MAKE_DIRECTORY "${_inline_rdf}")
        configure_file("${CMAKE_CURRENT_LIST_DIR}/../core/root_compat/InlineInputDefine.hxx" "${_inline_rdf}/InlineInputDefine.hxx" COPYONLY)
        file(READ "${_interface}" _inline_interface)
        string(REPLACE "ROOT/RDF/RDefine.hxx" "ROOT/RDF/InlineInputDefine.hxx" _inline_interface "${_inline_interface}")
        string(REPLACE "using NewCol_t = RDFDetail::RDefine<F, DefineType>;" "using NewCol_t = RDFDetail::InlineInputDefine<F, DefineType>;" _inline_interface "${_inline_interface}")
        file(CONFIGURE OUTPUT "${_inline_rdf}/RInterface.hxx" CONTENT "@_inline_interface@" @ONLY)
    endif()
endif()
if(RDF_ROOT_READER_AVAILABLE)
    file(CONFIGURE OUTPUT "${_rdf_registry_private}/ROOT/RDF/RDefineBase.hxx" CONTENT "@_base@" @ONLY)
    file(CONFIGURE OUTPUT "${_rdf_registry_private}/ROOT/RDF/RDefineReader.hxx" CONTENT "@_reader@" @ONLY)
endif()
add_library(RDFRootRegistryCompat OBJECT ${_rdf_sources})
target_include_directories(RDFRootRegistryCompat BEFORE PRIVATE "${_rdf_registry_private}" "${_rdf_registry_include}/ROOT/RDF")
target_link_libraries(RDFRootRegistryCompat PRIVATE ROOT::ROOTDataFrame)
target_compile_features(RDFRootRegistryCompat PRIVATE cxx_std_17)
if(RDF_ROOT_LOCALITY_AVAILABLE)
    target_compile_definitions(RDFRootRegistryCompat PRIVATE RDF_ROOT_PACKED_READER=1)
    set_source_files_properties("${CMAKE_CURRENT_LIST_DIR}/../core/root_compat/Root640PackedReader.cc"
        PROPERTIES COMPILE_OPTIONS "-Wno-pmf-conversions")
endif()
set_target_properties(RDFRootRegistryCompat PROPERTIES
    CXX_VISIBILITY_PRESET default VISIBILITY_INLINES_HIDDEN OFF)
string(REPLACE "." ";" _rdf_version_parts "${ROOT_VERSION}")
list(GET _rdf_version_parts 0 _major)
list(GET _rdf_version_parts 1 _minor)
list(GET _rdf_version_parts 2 _patch)
math(EXPR _expected_root_version "${_major} * 10000 + ${_minor} * 100 + ${_patch}")
target_compile_definitions(RDFRootRegistryCompat PRIVATE RDF_EXPECT_ROOT_VERSION=${_expected_root_version})
if(ROOT_VERSION STREQUAL "6.41.99")
    target_compile_definitions(RDFRootRegistryCompat PRIVATE RDF_EXPECT_ROOT_GIT_TAG="v6-42-00-rc1")
endif()
set_property(TARGET RDFRootRegistryCompat PROPERTY RDF_EXPORTED_SYMBOLS "${_rdf_symbols}")
message(STATUS "ROOT ${ROOT_VERSION} native registry=${RDF_ROOT_REGISTRY_AVAILABLE}, reader=${RDF_ROOT_READER_AVAILABLE}, locality=${RDF_ROOT_LOCALITY_AVAILABLE}")

# Apply through core's interface, evaluated for the final consuming target.
# Shared/Python modules keep their ordinary ROOT behavior; executable symbols
# must precede ROOT in ELF lookup, including for interpreter-compiled Defines.
function(rdf_attach_root_registry target)
    set(_native "$<STREQUAL:$<TARGET_PROPERTY:TYPE>,EXECUTABLE>")
    target_sources(${target} INTERFACE "$<${_native}:$<TARGET_OBJECTS:RDFRootRegistryCompat>>")
    get_target_property(_symbols RDFRootRegistryCompat RDF_EXPORTED_SYMBOLS)
    foreach(_symbol IN LISTS _symbols)
        target_link_options(${target} INTERFACE "$<${_native}:LINKER:--export-dynamic-symbol=${_symbol}>")
    endforeach()
endfunction()
