"""Public controller signatures; no native or numeric type dependencies."""
from dataclasses import dataclass
from os import PathLike
from typing import Any, Mapping, Optional, Protocol, Sequence, Tuple, Union
from rdfresults import RunResult

_Path = Union[str, PathLike[str]]

class _CancelEvent(Protocol):
    def is_set(self) -> bool: ...

@dataclass(frozen=True)
class ValidationIssue:
    code: str
    message: str
    location: str = ...
    def as_dict(self) -> dict[str, str]: ...

@dataclass(frozen=True)
class ValidationReport:
    level: str
    supported_levels: Tuple[str, ...]
    issues: Tuple[ValidationIssue, ...] = ...
    @property
    def passed(self) -> bool: ...
    def as_dict(self) -> dict[str, Any]: ...
    def raise_if_invalid(self) -> ValidationReport: ...

@dataclass(frozen=True)
class WorkflowDescription:
    backend: str
    capabilities: Tuple[str, ...]
    details: Mapping[str, Any]
    def as_dict(self) -> dict[str, Any]: ...
    def explain(self) -> str: ...

@dataclass(frozen=True)
class CommandResult:
    status: str
    returncode: Optional[int]
    command: Tuple[str, ...]
    wall_s: float
    log_directory: str
    outputs: Mapping[str, str] = ...
    issues: Tuple[ValidationIssue, ...] = ...
    provenance: Mapping[str, Any] = ...
    operation: str = ...
    progress: Mapping[str, Any] = ...
    @property
    def success(self) -> bool: ...
    def as_dict(self) -> dict[str, Any]: ...
    def raise_for_status(self) -> CommandResult: ...
    def to_run_result(self) -> RunResult: ...

class ExecutionError(RuntimeError):
    result: CommandResult
    def __init__(self, result: CommandResult) -> None: ...

@dataclass(frozen=True)
class CMakeBuildSpec:
    build_directory: str
    target: str
    parallel: int = ...
    configuration: Optional[str] = ...
    timeout_s: float = ...
    inputs: Mapping[str, str] = ...
    products: Mapping[str, str] = ...
    def __init__(self, build_directory: _Path, target: str, parallel: int = ...,
        configuration: Optional[str] = ..., timeout_s: float = ...,
        inputs: Mapping[str, _Path] = ..., products: Mapping[str, _Path] = ...) -> None: ...
    def build(self, log_directory: _Path, *, check: bool = ...,
        cancel_event: Optional[_CancelEvent] = ..., progress_interval_s: Optional[float] = ...) -> CommandResult: ...

@dataclass(frozen=True)
class LocalExecutionResources:
    cpus: Tuple[int, ...]
    def __init__(self, cpus: Sequence[int]) -> None: ...

@dataclass(frozen=True)
class CppAnalysisSpec:
    executable: str
    arguments: Tuple[str, ...] = ...
    working_directory: str = ...
    assets: Mapping[str, str] = ...
    outputs: Mapping[str, str] = ...
    libraries: Mapping[str, str] = ...
    environment: Mapping[str, str] = ...
    timeout_s: float = ...
    terminate_grace_s: float = ...
    build_spec: Optional[CMakeBuildSpec] = ...
    build_manifest: Optional[str] = ...
    resources: Optional[LocalExecutionResources] = ...
    def __init__(self, executable: _Path, arguments: Sequence[str] = ...,
        working_directory: _Path = ..., assets: Mapping[str, _Path] = ...,
        outputs: Mapping[str, _Path] = ..., libraries: Mapping[str, _Path] = ...,
        environment: Mapping[str, str] = ..., timeout_s: float = ...,
        terminate_grace_s: float = ..., build_spec: Optional[CMakeBuildSpec] = ...,
        build_manifest: Optional[_Path] = ...,
        resources: Optional[LocalExecutionResources] = ...) -> None: ...
    def command(self) -> Tuple[str, ...]: ...
    def validate(self, level: str = ...) -> ValidationReport: ...
    def describe(self) -> WorkflowDescription: ...
    def prepare(self) -> PreparedCppAnalysis: ...
    def run(self, log_directory: _Path, *, check: bool = ...,
        cancel_event: Optional[_CancelEvent] = ..., progress_interval_s: Optional[float] = ...) -> CommandResult: ...
    @classmethod
    def from_file(cls, path: _Path) -> CppAnalysisSpec: ...

@dataclass(frozen=True)
class PreparedCppAnalysis:
    spec: CppAnalysisSpec
    artifacts: Mapping[str, Any]
    preparation_s: float
    build_identity: Optional[str] = ...
    resource_tool: Optional[Mapping[str, str]] = ...
    def run(self, log_directory: _Path, *, check: bool = ...,
        cancel_event: Optional[_CancelEvent] = ..., progress_interval_s: Optional[float] = ...) -> CommandResult: ...

def read_command_status(log_directory: _Path) -> dict[str, Any]: ...
def read_command_result(log_directory: _Path) -> RunResult: ...
def main(argv: Optional[list[str]] = ...) -> int: ...
