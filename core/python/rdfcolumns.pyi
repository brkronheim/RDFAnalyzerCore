from dataclasses import dataclass
from typing import Any, Mapping, Optional, Sequence, Tuple, Union
from rdfschema import ColumnRequirement

@dataclass(frozen=True)
class KernelField:
    source: str
    index: int
    nominal: bool = ...

@dataclass(frozen=True)
class KernelOutputs:
    column: str
    fields: Tuple[str, ...]
    nominal: bool = ...
    def __init__(self, column: str, fields: Sequence[str], nominal: bool = ...) -> None: ...
    def __getitem__(self, name: str) -> KernelField: ...
    def describe(self) -> dict[str, Any]: ...

def named_kernel_arguments(outputs: KernelOutputs, return_type: str) -> str: ...
def projection_arguments(source: Union[str, KernelField], index: Optional[int],
    nominal: Optional[bool]) -> Tuple[str, int, bool]: ...

@dataclass(frozen=True)
class FieldMetadata:
    dtype: Optional[str] = ...
    unit: Optional[str] = ...
    description: str = ...
    def describe(self) -> dict[str, Any]: ...

@dataclass(frozen=True)
class CollectionRef:
    name: str
    fields: Mapping[str, str]
    alignment: Optional[str] = ...
    index_column: Optional[str] = ...
    index_target: Optional[str] = ...
    metadata: Mapping[str, FieldMetadata] = ...
    def __getitem__(self, field: str) -> str: ...
    def require_aligned(self, other: CollectionRef) -> CollectionRef: ...
    def schema_requirements(self) -> Tuple[ColumnRequirement, ...]: ...
    def describe(self) -> dict[str, Any]: ...
