from dataclasses import dataclass, field
from typing import Any, Callable, Mapping, Optional, Sequence, Tuple
from rdfanalysis import Analysis
from rdfworkflow import ValidationReport, WorkflowDescription

@dataclass(frozen=True)
class ActionClaim:
    kind: str
    name: str
    def as_dict(self) -> dict[str, str]: ...

@dataclass(frozen=True)
class ModuleSpec:
    name: str
    requires: Tuple[str, ...] = ...
    produces: Tuple[str, ...] = ...
    dependencies: Tuple[str, ...] = ...
    resources: Tuple[str, ...] = ...
    actions: Tuple[ActionClaim, ...] = ...
    implementation: str = ...
    outputs_at: str = ...
    settings_schema: Optional[Mapping[str, Any]] = ...
    capabilities: Tuple[str, ...] = ...
    documentation: str = ...
    def __init__(self, name: str, requires: Sequence[str] = ..., produces: Sequence[str] = ...,
        dependencies: Sequence[str] = ..., resources: Sequence[str] = ...,
        actions: Sequence[ActionClaim] = ..., implementation: str = ..., outputs_at: str = ...,
        settings_schema: Optional[Mapping[str, Any]] = ..., capabilities: Sequence[str] = ...,
        documentation: str = ...) -> None: ...
    def describe(self) -> WorkflowDescription: ...

@dataclass(frozen=True)
class AnalysisModule:
    spec: ModuleSpec
    builder: Callable[[Analysis, dict[str, Any]], Any]
    settings: Mapping[str, Any] = ...
    validate_settings: Optional[Callable[[dict[str, Any]], Optional[ValidationReport]]] = ...
    _settings_report: Optional[ValidationReport] = field(init=False, default=None)
    def validate(self) -> ValidationReport: ...
    def describe(self) -> WorkflowDescription: ...

class ModuleSequence:
    def __init__(self, modules: Sequence[AnalysisModule]) -> None: ...
    def describe(self) -> WorkflowDescription: ...
    def preview(self, analysis: Analysis) -> WorkflowDescription: ...
    def apply(self, analysis: Analysis) -> Analysis: ...

def discover_module_specs() -> Tuple[ModuleSpec, ...]: ...
