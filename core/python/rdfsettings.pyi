from dataclasses import dataclass
from os import PathLike
from typing import Any, Mapping, Optional, TypeVar, Union

_S = TypeVar('_S', bound='_Settings')
class _Settings:
    @classmethod
    def from_mapping(cls: type[_S], values: Union[_S, Mapping[str, Any]], *,
        base: Optional[Union[str, PathLike[str]]] = ...) -> _S: ...
    def native_options(self) -> dict[str, str]: ...
    def values(self) -> dict[str, Any]: ...
    @classmethod
    def schema(cls) -> dict[str, Any]: ...

@dataclass(frozen=True)
class InputSettings(_Settings):
    cache_enabled: Optional[bool] = ...
    cache_size_mb: Optional[int] = ...
    cache_statistics: Optional[bool] = ...
    cache_verbosity: Optional[int] = ...
    float_constants: Optional[str] = ...
    integer_constants: Optional[str] = ...
    aliases: Optional[str] = ...
    optional_branches: Optional[str] = ...
    friends: Optional[str] = ...

@dataclass(frozen=True)
class SkimSettings(_Settings):
    tree: Optional[str] = ...
    metadata_file: Optional[str] = ...
    systematics: Optional[bool] = ...
    compression_algorithm: Optional[str] = ...
    compression_level: Optional[int] = ...
