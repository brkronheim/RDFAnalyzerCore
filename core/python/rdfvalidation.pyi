from dataclasses import dataclass
from typing import Any, Callable, Mapping, Optional, Sequence, Tuple
from rdfworkflow import ValidationReport, WorkflowDescription

_Validator = Callable[[dict[str, Any]], Optional[ValidationReport]]

def validate_provider_settings(validator: _Validator, settings: Mapping[str, Any], *,
    location: str = ..., level: str = ...) -> ValidationReport: ...

@dataclass(frozen=True)
class SettingsSpec:
    name: str
    schema: Mapping[str, Any]
    validator: _Validator
    asset_validator: Optional[_Validator] = ...
    documentation: str = ...
    @property
    def supported_levels(self) -> Tuple[str, ...]: ...
    def validate(self, settings: Mapping[str, Any], *, level: str = ...,
        location: Optional[str] = ...) -> ValidationReport: ...
    def describe(self) -> WorkflowDescription: ...

def discover_settings_specs() -> Tuple[SettingsSpec, ...]: ...
def main(argv: Optional[Sequence[str]] = ...) -> int: ...
