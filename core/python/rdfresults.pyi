"""IDE signatures for the detached result envelope; runtime lives in rdfresults.py."""
from dataclasses import dataclass
from typing import Any, Mapping, Optional, Tuple

@dataclass(frozen=True)
class RunResult:
    backend: str
    status: str
    completion_scope: str
    counts: Mapping[str, int] = ...
    histograms: Mapping[str, Any] = ...
    sums: Mapping[str, Any] = ...
    timings: Mapping[str, float] = ...
    outputs: Mapping[str, str] = ...
    provenance: Mapping[str, Any] = ...
    details: Mapping[str, Any] = ...
    issues: Tuple[Mapping[str, Any], ...] = ...
    event_loops: Optional[int] = ...
    @property
    def success(self) -> bool: ...
    @classmethod
    def from_dict(cls, document: Mapping[str, object]) -> RunResult: ...
    def as_dict(self) -> dict[str, Any]: ...
