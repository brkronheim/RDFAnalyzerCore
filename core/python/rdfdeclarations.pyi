from dataclasses import dataclass
from typing import Any, Callable, Literal, Optional, Sequence, Tuple, Union
from rdfanalysis import Analysis
from rdfcolumns import KernelField, KernelOutputs
from rdfworkflow import WorkflowDescription, ValidationReport

@dataclass(frozen=True)
class RegularAxis:
    bins: int
    low: float
    high: float

@dataclass(frozen=True)
class VariableAxis:
    edges: Tuple[float, ...]
    def __init__(self, edges: Sequence[float]) -> None: ...

@dataclass(frozen=True)
class Observable:
    name: str
    column: str
    axis: Union[RegularAxis, VariableAxis]

@dataclass(frozen=True)
class HistogramGroup:
    name: str
    observables: Tuple[Observable, ...]
    regions: Tuple[Optional[str], ...] = ...
    variations: Union[str, Tuple[str, ...]] = ...
    families: Tuple[str, ...] = ...
    weight: str = ...
    def __init__(self, name: str, observables: Sequence[Observable],
        regions: Sequence[Optional[str]] = ..., variations: Union[str, Sequence[str]] = ...,
        families: Sequence[str] = ..., weight: str = ...) -> None: ...
    def resolve(self, labels: Sequence[str], *, budget: int, strict: bool = ...) -> list[dict[str, Any]]: ...

@dataclass(frozen=True)
class NDHistogramSettings:
    backend: Literal['root', 'boost'] = ...
    precision: Literal['float', 'double'] = ...
    sparse_backend: Literal['map', 'flat'] = ...
    dense_limit_mib: int = ...
    collection_layout: Literal['fixed', 'per-slot'] = ...
    def native_options(self) -> dict[str, str]: ...

@dataclass(frozen=True)
class NDCategoryAxis:
    column: str
    axis: RegularAxis
    labels: tuple[str, ...]
    def __init__(self, column: str, axis: RegularAxis, labels: Sequence[str]) -> None: ...
    def native_descriptor(self) -> tuple[Any, ...]: ...

@dataclass(frozen=True)
class NDHistogramSpec:
    name: str
    column: str
    axis: Union[RegularAxis, VariableAxis]
    weight: str
    label: str = ...
    force_sparse: bool = ...
    def native_descriptor(self) -> tuple[Any, ...]: ...

@dataclass(frozen=True)
class NDHistogramGroup:
    name: str
    histograms: tuple[NDHistogramSpec, ...]
    channel: Optional[NDCategoryAxis] = ...
    control: Optional[NDCategoryAxis] = ...
    sample: Optional[NDCategoryAxis] = ...
    variations: Literal['all', 'nominal'] = ...
    def __init__(self, name: str, histograms: Sequence[NDHistogramSpec], channel: Optional[NDCategoryAxis] = ...,
        control: Optional[NDCategoryAxis] = ..., sample: Optional[NDCategoryAxis] = ..., variations: Literal['all', 'nominal'] = ...) -> None: ...
    def native_descriptors(self, *, max_histograms: int = ...) -> tuple[Any, ...]: ...
    def describe(self) -> dict[str, Any]: ...

class Stage:
    def __init__(self, name: str, *, max_histograms: int = ..., record_sources: bool = ...) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def max_histograms(self) -> int: ...
    def register_variation(self, variable: str, label: str, column: str) -> Stage: ...
    def register_variation_pair(self, variable: str, family: str, up: str, down: str) -> Stage: ...
    def define(self, name: str, expression: str, columns: Sequence[str] = ...) -> Stage: ...
    def define_nominal(self, name: str, expression: str, columns: Sequence[str] = ...) -> Stage: ...
    def define_numba(self, name: str, function: Callable[..., Any], columns: Sequence[str], **kwargs: Any) -> Stage: ...
    def define_numba_outputs(self, outputs: KernelOutputs, function: Callable[..., Any],
        columns: Sequence[str], *, return_type: str, cache_version: Optional[Union[str, int]] = ..., require_native: bool = ...) -> Stage: ...
    def project(self, name: str, source: Union[str, KernelField], index: Optional[int] = ...,
        *, nominal: Optional[bool] = ...) -> Stage: ...
    def filter(self, name: str, expression: str, columns: Sequence[str] = ...) -> Stage: ...
    def filter_column(self, name: str, column: str) -> Stage: ...
    def region(self, name: str, column: str, *, parent: str = ...) -> Stage: ...
    def count(self, name: str) -> Stage: ...
    def sum(self, name: str, column: str) -> Stage: ...
    def histograms(self, group: HistogramGroup, *, batch: Optional[bool] = ...) -> Stage: ...
    def nd_histograms(self, group: NDHistogramGroup) -> Stage: ...
    def histogram(self, name: str, variable: str, bins: int, low: float, high: float, *,
        weight: str = ..., selection: str = ..., variation: str = ..., region: Optional[str] = ...) -> Stage: ...
    def histogram_variable(self, name: str, variable: str, edges: Sequence[float], *,
        weight: str = ..., selection: str = ..., variation: str = ..., region: Optional[str] = ...) -> Stage: ...
    def describe(self) -> WorkflowDescription: ...
    def preview(self, analysis: Analysis) -> WorkflowDescription: ...
    def validate(self, analysis: Analysis, *, strict: bool = ...) -> ValidationReport: ...
    def apply(self, analysis: Analysis) -> Analysis: ...
