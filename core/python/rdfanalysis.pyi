"""Public authoring signatures; native escape hatches and kernels stay explicit."""
from dataclasses import dataclass
from os import PathLike
from typing import Any, Callable, Mapping, Optional, Sequence, Tuple, Union
from rdfsettings import InputSettings as InputSettings, SkimSettings as SkimSettings
from rdfdeclarations import Stage as Stage, HistogramGroup as HistogramGroup, Observable as Observable, RegularAxis as RegularAxis, VariableAxis as VariableAxis
from rdfdeclarations import NDHistogramSettings as NDHistogramSettings, NDCategoryAxis as NDCategoryAxis, NDHistogramSpec as NDHistogramSpec, NDHistogramGroup as NDHistogramGroup
from rdfcolumns import KernelOutputs as KernelOutputs, KernelField as KernelField, CollectionRef as CollectionRef, FieldMetadata as FieldMetadata
from rdfmodules import ActionClaim as ActionClaim, ModuleSpec as ModuleSpec, AnalysisModule as AnalysisModule, ModuleSequence as ModuleSequence, discover_module_specs as discover_module_specs
from rdfvalidation import SettingsSpec as SettingsSpec, discover_settings_specs as discover_settings_specs
from rdfworkflow import WorkflowDescription, ValidationReport
from rdfresults import RunResult
from rdfschema import ColumnRequirement, InputSchema, InputSchemaCheck

@dataclass(frozen=True)
class AnalysisConfig:
    files: Tuple[str, ...]
    output: str
    tree: str = ...
    threads: int = ...
    systematics: bool = ...
    skim: bool = ...
    persist_histograms: bool = ...
    save_columns: Optional[Tuple[str, ...]] = ...
    options: Mapping[str, str] = ...
    entry_range: Optional[Tuple[int, int]] = ...
    range_mode: str = ...
    input_settings: InputSettings = ...
    skim_settings: SkimSettings = ...
    def __init__(self, files: Sequence[str], output: str, tree: str = ..., threads: int = ...,
        systematics: bool = ..., skim: bool = ..., persist_histograms: bool = ...,
        save_columns: Optional[Sequence[str]] = ..., options: Mapping[str, str] = ...,
        entry_range: Optional[Sequence[int]] = ..., range_mode: str = ...,
        input_settings: Union[InputSettings, Mapping[str, Any]] = ...,
        skim_settings: Union[SkimSettings, Mapping[str, Any]] = ...) -> None: ...
    @classmethod
    def from_file(cls, path: Union[str, PathLike[str]]) -> AnalysisConfig: ...
    def native_config(self) -> dict[str, str]: ...
    @classmethod
    def schema(cls) -> dict[str, Any]: ...
    def describe(self) -> WorkflowDescription: ...
    def validate(self, level: str = ...) -> ValidationReport: ...
    def check_schema(self, requirements: Sequence[ColumnRequirement], *,
        reader: Optional[Callable[[str, str, Tuple[str, ...]], InputSchema]] = ...) -> InputSchemaCheck: ...

class Analysis:
    config: AnalysisConfig
    native: Any
    def __init__(self, config: AnalysisConfig, *, record_graph: bool = ...) -> None: ...
    def define(self, name: str, expression: str, columns: Sequence[str] = ...) -> Analysis: ...
    def define_nominal(self, name: str, expression: str, columns: Sequence[str] = ...) -> Analysis: ...
    def define_numba(self, name: str, function: Callable[..., Any], columns: Sequence[str], *,
        return_type: Optional[str] = ..., nominal: bool = ..., cache_version: Optional[Union[str, int]] = ..., require_native: bool = ...) -> Analysis: ...
    @property
    def numba_bridges(self) -> list[dict[str, Any]]: ...
    @property
    def runtime_threading(self) -> dict[str, Any]: ...
    @property
    def compilation_stats(self) -> dict[str, Any]: ...
    def define_numba_outputs(self, outputs: KernelOutputs, function: Callable[..., Any], columns: Sequence[str], *,
        return_type: str, cache_version: Optional[Union[str, int]] = ..., require_native: bool = ...) -> Analysis: ...
    def project(self, name: str, source: Union[str, KernelField], index: Optional[int] = ...,
        *, nominal: Optional[bool] = ...) -> Analysis: ...
    def filter(self, name: str, expression: str, columns: Sequence[str] = ...) -> Analysis: ...
    def filter_column(self, name: str, column: str) -> Analysis: ...
    def count(self, name: str) -> Analysis: ...
    def nd_histograms(self, group: NDHistogramGroup, *, max_histograms: int = ...) -> Analysis: ...
    def histogram(self, name: str, variable: str, bins: int, low: float, high: float, *,
        weight: str = ..., selection: str = ..., variation: str = ..., region: Optional[str] = ...) -> Analysis: ...
    def histogram_batch(self, histograms: Sequence[Mapping[str, Any]], *, max_histograms: int = ...) -> Analysis: ...
    def histogram_variable(self, name: str, variable: str, edges: Sequence[float], *,
        weight: str = ..., selection: str = ..., variation: str = ..., region: Optional[str] = ...) -> Analysis: ...
    def correction_batch(self, role: str, correction: str, string_arguments: Sequence[Sequence[str]], *,
        outputs: Sequence[str], inputs: Sequence[str] = ..., propagate_systematics: Sequence[bool] = ...,
        vector: bool = ...) -> Analysis: ...
    def weights(self, components: Mapping[str, str], *, normalizations: Optional[Mapping[str, float]] = ...,
        variations: Optional[Mapping[str, Sequence[str]]] = ..., output: str = ...) -> dict[str, Any]: ...
    def region(self, name: str, column: str, *, parent: str = ...) -> Analysis: ...
    def sum(self, name: str, column: str) -> Analysis: ...
    def apply(self, stage: Stage) -> Analysis: ...
    def use(self, *modules: AnalysisModule) -> Analysis: ...
    @property
    def sums(self) -> dict[str, float]: ...
    @property
    def histograms(self) -> dict[str, Any]: ...
    @property
    def counts(self) -> dict[str, int]: ...
    def register_variation(self, variable: str, label: str, column: str) -> Analysis: ...
    def register_variation_pair(self, variable: str, family: str, up: str, down: str) -> Analysis: ...
    @property
    def columns(self) -> Sequence[str]: ...
    def has_column(self, name: str) -> bool: ...
    @property
    def variation_labels(self) -> Sequence[str]: ...
    @property
    def selection_masks(self) -> dict[str, str]: ...
    def run(self) -> Analysis: ...
    def result(self) -> RunResult: ...
    def inspect(self) -> dict[str, Any]: ...
    def describe(self, *, include_types: bool = ...) -> WorkflowDescription: ...
    def explain(self, name: Optional[str] = ..., *, variation: Optional[str] = ...) -> str: ...

class WorkerRecycleRequired(RuntimeError): ...

@dataclass(frozen=True)
class AnalysisResult:
    counts: dict[str, int]
    histograms: dict[str, Any]
    sums: dict[str, float]
    compilation: dict[str, Any]
    timing: dict[str, float]
    event_loops: int
    output: Optional[str]
    metadata: str
    nd_histograms: dict[str, Any] = ...
    def as_dict(self) -> dict[str, Any]: ...
    def to_run_result(self) -> RunResult: ...

class AnalysisSession:
    max_jobs: int
    max_numba_signatures: int
    def __init__(self, *, max_jobs: int = ..., max_numba_signatures: int = ...) -> None: ...
    @property
    def cache_info(self) -> dict[str, int]: ...
    def run(self, config: AnalysisConfig, builder: Callable[..., Any], *args: Any, **kwargs: Any) -> AnalysisResult: ...
    def close(self) -> None: ...
    def __enter__(self) -> AnalysisSession: ...
    def __exit__(self, *exc: Any) -> None: ...

def diagnose_runtime(*, numba: bool = ..., cms: bool = ..., require_capabilities: Sequence[str] = ...) -> dict[str, Any]: ...
def main(argv: Optional[Sequence[str]] = ...) -> int: ...
